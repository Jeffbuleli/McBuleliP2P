{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_NGEMBA_API_URL": "https://ngemba.cyberalert-rdc.org"
      }
    },
    "preview": {
      "distribution": "internal",
      "credentialsSource": "local",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_NGEMBA_API_URL": "https://ngemba.cyberalert-rdc.org"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_NGEMBA_API_URL": "https://ngemba.cyberalert-rdc.org"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
