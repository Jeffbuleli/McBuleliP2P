{
  "expo": {
    "name": "NGEMBA",
    "slug": "ngemba",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ngemba",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#06402b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.mcbuleli.ngemba",
      "buildNumber": "3",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "NGEMBA utilise votre position pour orienter l'aide, jamais obligatoire.",
        "NSMotionUsageDescription": "NGEMBA detecte une secousse pour ouvrir le mode discret."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#06402b"
      },
      "package": "org.mcbuleli.ngemba",
      "versionCode": 3,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE",
        "android.permission.HIGH_SAMPLING_RATE_SENSORS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NGEMBA utilise votre position pour orienter l'aide, jamais obligatoire."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "ngembaApiUrl": "https://ngemba.cyberalert-rdc.org",
      "eas": {
        "projectId": "42bb1cda-6899-4c01-bd95-5f55c60f9428"
      }
    },
    "owner": "mcbuleli-inc"
  }
}
