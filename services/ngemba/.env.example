# NGEMBA - Phase 0 local
DATABASE_URL=postgresql://localhost:5432/ngemba_dev

NEXT_PUBLIC_APP_URL=http://localhost:3012
APP_URL=http://localhost:3012

# Session store Phase 1 - dual-write JSON + Postgres when DATABASE_URL set
# NGEMBA_SESSION_PRIMARY=json
# NGEMBA_SESSION_PRIMARY=postgres

# Phase 3 - RBAC/ABAC bridge (tokens → actor + accreditation)
# Tables: ng_organizations, ng_org_members, ng_accreditations, ng_audit_access_log

# IA - local = 0 credit OpenAI (recommande en local)
NGEMBA_AI_MODE=hybrid
# NGEMBA_K_ANONYMITY=5
# OPENAI_API_KEY=              # héritée McBuleli / VPS .env
# OPENAI_WHISPER_MODEL=whisper-1
# OPENAI_ASSISTANT_MODEL=gpt-4o-mini
# ELEVEN_LABS=
# ELEVENLABS_VOICE_ID=
# IA conversation : Claude Haiku (rapide). Clé racine : ANTROPIC_KEY
# ANTROPIC_KEY=
# NGEMBA_ANTHROPIC_MODEL=claude-haiku-5-5
# Telegram : le bot répond en direct (texte + vocal). Le secret doit matcher setWebhook.
# Telegram_Bot_Token=
# NGEMBA_TELEGRAM_WEBHOOK_SECRET=

# GPS - Geoapify (PAS OpenAI). Sinon fallback national RDC (provinces + villes).
# GEOAPIFY_API_KEY=

# Ops - token pour /ops/login (prod)
# NGEMBA_OPS_TOKEN=
# Codes personnels de l'equipe hackathon (ne pas commiter les valeurs)
# NGEMBA_OPS_TOKEN_JEFF=
# NGEMBA_OPS_TOKEN_JEREMIE=
# NGEMBA_OPS_TOKEN_JOYCE=
# NGEMBA_OPS_TOKEN_TIMOTHE=
# NGEMBA_OPS_TOKEN_SCHOOL=
# Alertes ops - Resend domaine mcbuleli.org → hi@mcbuleli.org
NGEMBA_OPS_EMAIL=hi@mcbuleli.org
NGEMBA_OPS_EMAIL_BCC=ceo@mcbuleli.org
NGEMBA_OPS_EMAIL_FROM=NGEMBA <noreply@mcbuleli.org>
NGEMBA_OPS_EMAIL_REPLY_TO=hi@mcbuleli.org
NGEMBA_OPS_PILOT_VERIFIED=false
# RESEND_API_KEY=   # meme cle Resend McBuleli (domaine mcbuleli.org)
# NGEMBA_OPS_WEBHOOK_URL=   # n8n Production webhook (NGEMBA-RDC workflow)
# NGEMBA_N8N_WEBHOOK_SECRET= # HMAC sha256 header X-Ngemba-Signature
# NGEMBA_N8N_WEBHOOK_TIMEOUT_MS=8000
# LLM aligné (triage + accompagnement) : openai | nvidia | auto
# NGEMBA_LLM_PROVIDER=auto
# NGEMBA_LLM_TIMEOUT_MS=14000
# NGEMBA_NVIDIA_API_KEY=     # NVIDIA NIM (integrate.api.nvidia.com)
# NGEMBA_NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# NGEMBA_SMS_WEBHOOK_URL=          # POST { phone, message, sessionId }
# Africa's Talking (optionnel)
# NGEMBA_AT_USERNAME=
# NGEMBA_AT_API_KEY=
# NGEMBA_AT_FROM=NGEMBA
