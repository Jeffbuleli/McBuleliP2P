# Ops VPS - ngemba.cyberalert-rdc.org
# Copy to ops/vps/.env on the server (never commit).

NEXT_PUBLIC_APP_URL=https://ngemba.cyberalert-rdc.org
APP_URL=https://ngemba.cyberalert-rdc.org

# local | hybrid | openai
NGEMBA_AI_MODE=hybrid
NGEMBA_LOCAL_SKIP_THRESHOLD=0.72
NGEMBA_OPENAI_MAX_TOKENS=350

# OpenAI - triage hybrid + Whisper (clé McBuleli)
# OPENAI_API_KEY=
# OPENAI_WHISPER_MODEL=whisper-1
# OPENAI_ASSISTANT_MODEL=gpt-4o-mini

# Optional - reverse GPS (SafeFind pattern). Not OpenAI.
# GEOAPIFY_API_KEY=

# --- Ops (Bloc A) ---
# Token obligatoire en prod pour /ops (min 8 caracteres)
NGEMBA_OPS_TOKEN=change-me-long-secret

# Email ops - verification McBuleli (hi@) avant acces Me Arjoule / JGL
NGEMBA_OPS_EMAIL=hi@mcbuleli.org
NGEMBA_OPS_EMAIL_BCC=ceo@mcbuleli.org
NGEMBA_OPS_EMAIL_FROM=McBuleli NGEMBA <noreply@mcbuleli.org>
NGEMBA_OPS_EMAIL_REPLY_TO=hi@mcbuleli.org
NGEMBA_OPS_PILOT_VERIFIED=false
# Apres validation JGL : NGEMBA_OPS_PILOT_VERIFIED=true et NGEMBA_OPS_EMAIL=akarhinda@gmail.com
NGEMBA_OPS_PARTNER_NAME=Justicia Great Lakes (JGL AFRICA)
NGEMBA_OPS_PARTNER_CONTACT=Me Arjoule Karinda

# Tokens ops par role (min 32 caracteres - openssl rand -hex 24)
# NGEMBA_OPS_TOKEN_ADMIN=...   # ou NGEMBA_OPS_TOKEN pour admin legacy
NGEMBA_OPS_TOKEN_NGO=change-me-ngo-token-min-32-chars
# NGEMBA_OPS_TOKEN_SECURITY=...
# NGEMBA_OPS_TOKEN_PARTNER=...

# Webhook JSON sur nouvelle alerte - optionnel
# NGEMBA_OPS_WEBHOOK_URL=https://hooks.example.com/ngemba

# SMS contacts de confiance (optionnel)
# NGEMBA_SMS_WEBHOOK_URL=https://hooks.example.com/ngemba-sms
# Africa's Talking
# NGEMBA_AT_USERNAME=
# NGEMBA_AT_API_KEY=
# NGEMBA_AT_FROM=NGEMBA

# Media R2 Cyber Alert (media.cyberalert-rdc.org/ngemba/...)
# Fallback automatique sur SAFEFIND_R2_* si presents dans le meme .env
# NGEMBA_R2_ACCOUNT_ID=
# NGEMBA_R2_BUCKET=cyberalert-safefind
# NGEMBA_R2_ACCESS_KEY_ID=
# NGEMBA_R2_SECRET_ACCESS_KEY=
# NGEMBA_R2_PUBLIC_BASE_URL=https://media.cyberalert-rdc.org
